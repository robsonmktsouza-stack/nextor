APP_NAME="Lumeron Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumeron_control
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Disparos externos ficam desativados por padrão. Configure SMTP real.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Lumeron"
LUMERON_CLIENT_EMAIL_ENABLED=false

# Laragon: ative uma vez para provisionar novos cadastros em segundo plano
# Execute também php artisan schedule:work em um terminal dedicado.
LUMERON_LOCAL_PROVISIONING=false
# Opcional, se Nextor não estiver na pasta irmã do Control:
LUMERON_LOCAL_ERP_SOURCE=
# Opcional: URL real do Control (ex.: http://127.0.0.1:8000)
LUMERON_LOCAL_CONTROL_URL=
