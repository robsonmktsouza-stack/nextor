APP_NAME="ERP Estoque e Vendas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_estoque_vendas
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Dados do emitente usados no modelo de impressão NFC-e
FISCAL_ISSUER_NAME="Razão Social do Emitente"
FISCAL_ISSUER_CNPJ=
FISCAL_ISSUER_ADDRESS="Logradouro, número, bairro, município - UF"

# Comunicação SEFAZ (homologação)
FISCAL_SEFAZ_CONNECT_TIMEOUT_MS=5000
FISCAL_SEFAZ_REQUEST_TIMEOUT_MS=15000

# Teste live é opt-in e nunca deve ser habilitado no CI normal.
FISCAL_LIVE_TESTS=false
FISCAL_LIVE_COMPANY_ID=
